<resources>

    <style name="Base.Theme.ProjectTwo" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/red_light</item>
        <item name="colorPrimaryVariant">@color/red_dark</item>
        <item name="colorSecondary">@color/red_primary</item>

        <!-- Material3 container colors -->
        <item name="colorPrimaryContainer">@color/red_dark</item>
        <item name="colorSecondaryContainer">@color/red_primary</item>

        <!-- Force white button text in dark mode -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- System UI -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/black</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/white</item>

    </style>

</resources>